# Leaf workstation: ICU bed 1. Ports 7310-7319.
FLORA_LEAF_ID=leaf-icu-01
FLORA_LEAF_NAME=ICU Bed 1
FLORA_HOSPITAL_ID=hospital-01
LEAF_WEB_PORT=7310
LEAF_API_PORT=7311
LEAF_DB_PORT=7312
LEAF_LIVE_PORT=7313
# Canopy TLS edge: 443 in production; 9443 on this dev machine (Root uses 8443).
CANOPY_SYNC_URL=https://host.docker.internal:9443
HABER_URL=https://host.docker.internal:9443
LEAF_DEVICE_READ_URL=https://host.docker.internal:7443/data-api/leaf-icu-01/api/observations
FLORA_SYNC_SHARED_SECRET=flora-sync-demo-secret-change-me
FLORA_LEAF_SERVICE_SECRET=flora-leaf-icu-01-service-demo-secret
# Leaf HTTPS edge: 443 in production; 7353 on this dev machine.
LEAF_HTTPS_PORT=7353

# --- HTTPS (self-signed; scripts/tls/make-cert.sh flora-leaf flora-leaf/env/leaf-icu-01.env) ---------------------------
# Names/IPs this tier is reached by (browsers, tablets, other tiers). Re-run the script
# after changing them; the certificate is reissued automatically.
TLS_HOSTNAMES=localhost,host.docker.internal,127.0.0.1,10.149.1.22,leaf-icu-01.local
TLS_CERT_FILE=./certs/leaf-icu-01.crt
TLS_KEY_FILE=./certs/leaf-icu-01.key
# Shared Flora CA that signs every tier (install certs/flora-ca.crt once per device).
TLS_CA_FILE=../certs/flora-ca.crt
TLS_CA_KEY_FILE=../certs/flora-ca.key
