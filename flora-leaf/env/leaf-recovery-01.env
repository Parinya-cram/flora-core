# Demo Leaf workstation: Recovery. Ports 7370-7379.
# Lean demo stack (leaf-db, leaf-api, leaf-sync) on the shared network flora-demo-leaves:
#   docker compose -f flora-leaf/compose.yaml -f flora-leaf/compose.demo-shared.yaml -p flora-leaf-recovery-01 --env-file flora-leaf/env/leaf-recovery-01.env up -d leaf-db leaf-api leaf-sync
# Open it from the workstation switcher (login page / user menu) of any Leaf web, e.g. http://localhost:7300.
FLORA_LEAF_ID=leaf-recovery-01
FLORA_LEAF_NAME=Recovery
FLORA_HOSPITAL_ID=hospital-01
LEAF_WEB_PORT=7370
LEAF_API_PORT=7371
LEAF_DB_PORT=7372
CANOPY_SYNC_URL=https://host.docker.internal:9443
HABER_URL=https://host.docker.internal:9443
LEAF_DEVICE_READ_URL=https://host.docker.internal:7443/data-api/leaf-recovery-01/api/observations
FLORA_SYNC_SHARED_SECRET=flora-sync-demo-secret-change-me
FLORA_LEAF_SERVICE_SECRET=flora-leaf-recovery-01-service-demo-secret
