# Leaf workstation: Operating Room 1. Ports 7300-7309.
FLORA_LEAF_ID=leaf-or-01
FLORA_LEAF_NAME=Operating Room 1
FLORA_HOSPITAL_ID=hospital-01
LEAF_WEB_PORT=7300
LEAF_API_PORT=7301
LEAF_DB_PORT=7302
LEAF_LIVE_PORT=7303
# Canopy TLS edge: 443 in production; 9443 on this dev machine (Root uses 8443).
CANOPY_SYNC_URL=https://host.docker.internal:9443
HABER_URL=https://host.docker.internal:9443
LEAF_DEVICE_READ_URL=https://host.docker.internal:7443/data-api/leaf-or-01/api/observations
FLORA_SYNC_SHARED_SECRET=flora-sync-demo-secret-change-me
FLORA_LEAF_SERVICE_SECRET=flora-leaf-or-01-service-demo-secret
# Leaf HTTPS edge: 443 in production; 7343 on this dev machine.
LEAF_HTTPS_PORT=7343

# --- HTTPS (self-signed; scripts/tls/make-cert.sh flora-leaf flora-leaf/env/leaf-or-01.env) ---------------------------
# Names/IPs this tier is reached by (browsers, tablets, other tiers). Re-run the script
# after changing them; the certificate is reissued automatically.
TLS_HOSTNAMES=localhost,host.docker.internal,127.0.0.1,10.149.1.22,leaf-or-01.local
TLS_CERT_FILE=./certs/leaf-or-01.crt
TLS_KEY_FILE=./certs/leaf-or-01.key
# Shared Flora CA that signs every tier (install certs/flora-ca.crt once per device).
TLS_CA_FILE=../certs/flora-ca.crt
TLS_CA_KEY_FILE=../certs/flora-ca.key
