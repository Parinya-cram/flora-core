# Demo Leaf workstation: Operating Room 2. Ports 7360-7369.
# Lean demo stack (leaf-db, leaf-api, leaf-sync) on the shared network flora-demo-leaves:
#   docker compose -f flora-leaf/compose.yaml -f flora-leaf/compose.demo-shared.yaml -p flora-leaf-or-02 --env-file flora-leaf/env/leaf-or-02.env up -d leaf-db leaf-api leaf-sync
# Open it from the workstation switcher (login page / user menu) of any Leaf web, e.g. http://localhost:7300.
FLORA_LEAF_ID=leaf-or-02
FLORA_LEAF_NAME=Operating Room 2
FLORA_HOSPITAL_ID=hospital-01
LEAF_WEB_PORT=7360
LEAF_API_PORT=7361
LEAF_DB_PORT=7362
CANOPY_SYNC_URL=https://host.docker.internal:9443
HABER_URL=https://host.docker.internal:9443
LEAF_DEVICE_READ_URL=https://host.docker.internal:7443/data-api/leaf-or-02/api/observations
FLORA_SYNC_SHARED_SECRET=flora-sync-demo-secret-change-me
FLORA_LEAF_SERVICE_SECRET=flora-leaf-or-02-service-demo-secret
