# Production frontend: serve the built SPA + proxy API to the tier's backend.
# ${API_UPSTREAM} is filled by the nginx entrypoint (envsubst) from the env var,
# e.g. http://leaf-api:8000 or http://canopy-api:8000. nginx's own $vars are left
# untouched (the entrypoint only substitutes defined env vars).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # SPA client-side routing: fall back to index.html
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Leaf live stream WebSocket (docs/live-stream/PROTOCOL.md) → leaf-live. Resolved per
  # request (Docker DNS), so a stack without leaf-live (Canopy, or a Leaf without the
  # "live" profile) still starts; there /api/live/ answers 502.
  location /api/live/ {
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $leaf_live ${LIVE_HOST};
    proxy_pass http://$leaf_live;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # API + health go to this tier's API (replaces the Vite dev proxy)
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }
  location /health {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
  }
}
