# Flora ICIS production settings, shared by every *.floraicis.prod.yml stack.
#
#   cp floraicis.prod.env.example floraicis.prod.env    # never commit the real file
#   docker compose -f <tier>.floraicis.prod.yml --env-file floraicis.prod.env up -d --build
#
# Generate each secret with:  openssl rand -hex 32

# ---- public ports (one per tier) and bind address
FLORA_BIND_ADDR=0.0.0.0
FLORAICIS_ROOT_PORT=7100
FLORAICIS_CANOPY_PORT=7200
FLORAICIS_LEAF_PORT=7300
FLORAICIS_GATEWAY_PORT=7400

# ---- how the tiers reach each other (defaults assume all tiers on one host)
FLORAICIS_ROOT_URL=http://host.docker.internal:7100
FLORAICIS_CANOPY_URL=http://host.docker.internal:7200
FLORAICIS_GATEWAY_URL=http://host.docker.internal:7400
# host:port nodes' Docker daemons pull approved images from (Canopy edge /v2/).
# Anything but localhost needs an "insecure-registries" entry or TLS in front.
HABER_REGISTRY_PUBLIC=localhost:7200

# ---- database tier (db.floraicis.prod.yml); the tiers use the same values
FLORA_ROOT_DB_PASSWORD=
CANOPY_DB_ADMIN_PASSWORD=
CANOPY_DB_APP_PASSWORD=
CANOPY_DB_VIEW_PASSWORD=
CANOPY_DB_SYNC_PASSWORD=
LEAF_DB_ADMIN_PASSWORD=
LEAF_DB_APP_PASSWORD=
LEAF_DB_VIEW_PASSWORD=
LEAF_DB_SYNC_PASSWORD=
FLORA_GATEWAY_DB_PASSWORD=

# ---- Root
ROOT_ADMIN_KEY=
ROOT_ADMIN_PASSWORD=

# ---- Canopy / Haber
CANOPY_SESSION_SECRET=
CANOPY_ADMIN_PASSWORD=
HABER_ADMIN_PASSWORD=
FLORA_TENANT_ID=hospital-01
FLORA_ROOT_TENANT_KEY=
FLORA_ROOT_PUBLIC_KEY=

# ---- shared between Canopy, Leaf and Gateway
FLORA_SYNC_SHARED_SECRET=
HABER_GATEWAY_TOKEN=
HABER_NODE_TOKEN=

# ---- Leaf
FLORA_LEAF_ID=leaf-or-01
FLORA_HOSPITAL_ID=hospital-01
FLORA_LEAF_NAME=Operating Room 1
FLORA_LEAF_SERVICE_SECRET=
LEAF_ADMIN_PASSWORD=

# ---- Gateway
FLORA_GATEWAY_ID=gateway-hospital-01-a
GATEWAY_ADMIN_KEY=
GATEWAY_ADMIN_PASSWORD=
