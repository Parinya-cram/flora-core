   "sql": "SELECT r.record_id, r.schema_version, r.data, r.ingested_at, page.sv AS order_value FROM (SELECT * FROM (SELECT k.record_id AS rid, s.value_num AS sv, 0 AS nb FROM formdev_record_index s JOIN formdev_record k ON k.record_id = s.record_id WHERE s.form_id = ? AND s.field_id = ? AND s.value_num IS NOT NULL AND s.status <> 'deleted' AND k.form_id = ? AND k.status <> 'deleted' ORDER BY s.value_num ASC, k.record_id ASC LIMIT ?) b1 UNION ALL SELECT * FROM (SELECT k.record_id AS rid, CAST(NULL AS DOUBLE PRECISION) AS sv, 1 AS nb FROM formdev_record k WHERE k.form_id = ? AND k.status <> 'deleted' AND NOT EXISTS (SELECT 1 FROM formdev_record_index m1 WHERE m1.record_id = k.record_id AND m1.field_id = ?) ORDER BY k.record_id ASC LIMIT ?) b2) page JOIN formdev_record r ON r.record_id = page.rid ORDER BY page.nb, page.sv ASC, page.rid ASC LIMIT ? OFFSET ?",
