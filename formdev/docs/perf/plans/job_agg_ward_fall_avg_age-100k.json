   "sql": "SELECT * FROM (SELECT p.f0 AS g0, p.f1 AS g1, COUNT(*) AS a0, AVG(p.f2) AS a1 FROM (SELECT k.record_id AS rid, MAX(CASE WHEN x.field_id = ? THEN x.value_text END) AS f0, MAX(CASE WHEN x.field_id = ? THEN x.value_text END) AS f1, MAX(CASE WHEN x.field_id = ? THEN x.value_num END) AS f2 FROM formdev_record k LEFT JOIN formdev_record_index x ON x.record_id = k.record_id AND x.field_id IN (?, ?, ?) WHERE k.form_id = ? AND k.status <> 'deleted' GROUP BY k.record_id) p GROUP BY p.f0, p.f1) q ORDER BY (q.g0 IS NULL), q.g0 ASC, (q.g1 IS NULL), q.g1 ASC LIMIT ?",
