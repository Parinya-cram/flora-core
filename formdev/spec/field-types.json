{
  "description": "Field type registry (Phase 1.3). Single source of truth for both runtimes: services/flora-api/app/formdev/field_types.py and frontend/src/formdev/core/fieldTypes.ts must equal this file (checked by tests). value = how a value is stored and validated; query = Phase 4 query family (blob and list can be selected but not filtered, sorted or grouped; null: not queryable); index = record index column family (null: cannot be indexed); props = type-specific properties allowed in addition to common (or common_container for fields without a value).",
  "common": ["id", "key", "type", "label", "description", "required", "readonly", "hidden", "visible", "display", "layout", "style", "validation", "visibility", "clear_when_hidden", "permission", "indexed"],
  "common_container": ["id", "type", "label", "description", "readonly", "hidden", "visible", "display", "layout", "style", "visibility", "clear_when_hidden", "permission"],
  "types": {
    "text": { "value": "text", "query": "text", "index": "text", "props": ["unit", "max_length", "placeholder", "derive"] },
    "textarea": { "value": "text", "query": "longtext", "index": null, "props": ["max_length", "placeholder"] },
    "number": { "value": "number", "query": "num", "index": "num", "props": ["unit", "min", "max", "placeholder"] },
    "decimal": { "value": "decimal", "query": "num", "index": "num", "props": ["unit", "min", "max", "decimals", "placeholder"] },
    "integer": { "value": "integer", "query": "num", "index": "num", "props": ["unit", "min", "max", "placeholder"] },
    "date": { "value": "date", "query": "text", "index": "text", "props": [] },
    "datetime": { "value": "datetime", "query": "datetime", "index": "datetime", "props": [] },
    "time": { "value": "time", "query": "text", "index": "text", "props": [] },
    "select": { "value": "option", "query": "text", "index": "text", "props": ["options", "placeholder", "lookup"] },
    "radio": { "value": "option", "query": "text", "index": "text", "props": ["options", "lookup"] },
    "multiselect": { "value": "options", "query": "multi", "index": null, "props": ["options", "lookup"] },
    "checkbox": { "value": "boolean", "query": "bool", "index": "num", "props": [] },
    "switch": { "value": "boolean", "query": "bool", "index": "num", "props": [] },
    "file": { "value": "file", "query": "blob", "index": null, "props": ["accept", "max_size_kb", "multiple"] },
    "image": { "value": "file", "query": "blob", "index": null, "props": ["accept", "max_size_kb", "multiple"] },
    "signature": { "value": "signature", "query": "blob", "index": null, "props": ["max_size_kb"] },
    "calculated": { "value": "number", "query": "num", "index": "num", "props": ["unit", "formula", "calculator", "decimals"] },
    "group": { "value": null, "query": null, "index": null, "props": ["fields", "columns"] },
    "repeat": { "value": "list", "query": "list", "index": null, "props": ["fields", "columns", "min_items", "max_items"] }
  }
}
