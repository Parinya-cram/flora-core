# Flora shared development server (Ubuntu @ 172.22.1.103)
# Copy to .env on the server and adjust.  Never commit the real .env.
#
#   cp .env.server.example .env
#
# Difference from .env.example (workstation): services bind to all interfaces
# so both developers can reach the API and database from their own machines.

# Expose to the LAN.  Use 127.0.0.1 on a workstation.
FLORA_BIND_ADDR=0.0.0.0

FLORA_LEAF_PORT=6890
FLORA_POSTGRES_PORT=6892
FLORA_LEAF_API_PORT=6893
FLORA_CANOPY_PORT=6894
FLORA_CANOPY_API_PORT=6895
FLORA_SYNC_API_PORT=6896
FLORA_LIVEAGENT_PORT=6897

FLORA_POSTGRES_DB=flora
FLORA_POSTGRES_ADMIN_USER=flora_admin
FLORA_POSTGRES_ADMIN_PASSWORD=replace-with-a-random-admin-password
FLORA_DB_APP_PASSWORD=replace-with-a-random-app-password
FLORA_DB_VIEW_PASSWORD=replace-with-a-random-view-password
FLORA_DB_SYNC_PASSWORD=replace-with-a-random-sync-password
FLORA_CANOPY_SESSION_SECRET=replace-with-at-least-32-random-characters
FLORA_SYNC_SHARED_SECRET=replace-with-at-least-32-random-characters
FLORA_LEAF_SERVICE_SECRET=replace-with-at-least-32-random-characters

FLORA_LEAF_ID=leaf-dev-01
FLORA_HOSPITAL_ID=hospital-dev
FLORA_LEAF_NAME=Shared Development Leaf
FLORA_SYNC_INTERVAL_SECONDS=10
FLORA_LEAF_WRITE_API=true

FLORA_BOOTSTRAP_ADMIN_ENABLED=true
FLORA_BOOTSTRAP_ADMIN_USERNAME=admin
FLORA_BOOTSTRAP_ADMIN_PASSWORD=admin
FLORA_BOOTSTRAP_ADMIN_NAME=Administrator

FLORA_DEVICE_INGEST_ENABLED=true
VECTOR_READ_URL=http://flora-liveagent:8000/api/observations
HIS_GATEWAY_BASE_URL=http://10.35.202.6:8590
FLORA_HIS_DEMO_MODE=true

FLORA_INNOVIAN_ARCHIVE_URL=http://host.docker.internal:8000/api/v1
FLORA_INNOVIAN_ARCHIVE_SUBJECT=hospital-nit
FLORA_INNOVIAN_ARCHIVE_KEY=
FLORA_INNOVIAN_MAX_CASE_MINUTES=1440

LIVEAGENT_PROFILE=stable-anes
LIVEAGENT_SEED=17
LIVEAGENT_MAX_WINDOW_MINUTES=240
