# Demo only: several Leafs in one container (leaf.floraicis.demo.yml). One leaf-api + one sync worker per Leaf,
# behind one nginx that serves the Leaf UI and routes /ws/<leaf-id>/ to that Leaf's API. Each Leaf has its own
# database on the shared leaf-db, created on first start from the same init scripts as the leaf-db image.

# ---- Leaf UI ----
FROM node:22-bookworm-slim AS web
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
ENV VITE_FLORA_SURFACE=leaf
RUN npm run build \
    && sed -i 's#</head>#<script src="/demo-workstations.js"></script></head>#' dist/index.html

# ---- leaf-db init scripts, in the order Dockerfile.postgres.dev installs them ----
FROM busybox:1.37 AS initdb
WORKDIR /src
COPY Dockerfile.postgres.dev ./
COPY infrastructure/postgres ./infrastructure/postgres
COPY docs/database/flora-schema.sql ./docs/database/flora-schema.sql
RUN mkdir /initdb && grep '^COPY ' Dockerfile.postgres.dev | while read -r _ src dest; do \
      cp "$src" "/initdb/$(basename "$dest")"; \
    done

# ---- runtime ----
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-core nginx postgresql-client \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default
WORKDIR /app
COPY services/flora-api/requirements.txt ./requirements.txt
COPY services/flora-sync-worker/requirements.txt ./sync-requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -r sync-requirements.txt
COPY services/flora-api/scripts/fetch_ocr_models.py ./scripts/
RUN python scripts/fetch_ocr_models.py /opt/flora-ocr
ENV FLORA_OCR_MODELS=/opt/flora-ocr \
    PYTHAINLP_DATA=/tmp/pythainlp-data
COPY services/flora-api/app ./app
COPY services/flora-sync-worker/sync_worker.py /worker/sync_worker.py
COPY --from=initdb /initdb /initdb
COPY --from=web /app/frontend/dist /usr/share/nginx/html
COPY flora-leaf/demo/entrypoint.sh /entrypoint.sh
EXPOSE 80
CMD ["/entrypoint.sh"]
